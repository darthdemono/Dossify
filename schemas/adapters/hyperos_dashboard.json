{
  "$id": "https://dossify.dev/schemas/adapters/hyperos-dashboard-export/1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exporter's CSV carries no device facts, so the owner may record them here.",
  "properties": {
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "exporter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exporter Version"
    },
    "hyperos_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hyperos Version"
    },
    "phone_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phone Model"
    },
    "source": {
      "format": "path",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "source"
  ],
  "title": "HyperOSConfig",
  "type": "object"
}
