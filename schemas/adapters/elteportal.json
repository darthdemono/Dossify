{
  "$id": "https://dossify.dev/schemas/adapters/elteportal-journal/1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "default": true,
      "title": "Canvas",
      "type": "boolean"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "grades": {
      "default": true,
      "title": "Grades",
      "type": "boolean"
    },
    "neptun_ics": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Neptun Ics"
    },
    "profile": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "settings": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settings"
    }
  },
  "title": "ElteConfig",
  "type": "object"
}
